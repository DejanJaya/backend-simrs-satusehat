{
  "info": {
    "name": "SATUSEHAT Workshop - Rawat Jalan (Klinik Outpatient)",
    "description": "Koleksi Workshop Resmi SATUSEHAT Kemenkes RI untuk Alur Rawat Jalan (Pasien Datang -> Dokter -> Farmasi -> Selesai)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autentikasi OAuth2",
      "item": [
        {
          "name": "1.1 Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    console.log('✅ Access Token berhasil disimpan otomatis ke variabel Postman!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "{{client_id}}" },
                { "key": "client_secret", "value": "{{client_secret}}" }
              ]
            },
            "url": {
              "raw": "{{auth_url}}/accesstoken?grant_type=client_credentials",
              "host": ["{{auth_url}}"],
              "path": ["accesstoken"],
              "query": [{ "key": "grant_type", "value": "client_credentials" }]
            }
          }
        }
      ]
    },
    {
      "name": "2. Pasien Datang (Pendaftaran & Encounter Arrived)",
      "item": [
        {
          "name": "2.1 Cari Pasien by NIK (MPI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.entry && json.entry.length > 0) {",
                  "    var patientId = json.entry[0].resource.id;",
                  "    pm.collectionVariables.set('patient_ihs', patientId);",
                  "    console.log('✅ Patient IHS tersimpan:', patientId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/Patient?identifier=https://fhir.kemkes.go.id/id/nik|{{nik_pasien}}",
              "host": ["{{base_url}}"],
              "path": ["Patient"],
              "query": [{ "key": "identifier", "value": "https://fhir.kemkes.go.id/id/nik|{{nik_pasien}}" }]
            }
          }
        },
        {
          "name": "2.2 Buat Kunjungan Encounter (Status: arrived)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('encounter_id', json.id);",
                  "    console.log('✅ Encounter ID tersimpan:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Encounter\",\n  \"status\": \"arrived\",\n  \"class\": {\n    \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n    \"code\": \"AMB\",\n    \"display\": \"ambulatory\"\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_ihs}}\",\n    \"display\": \"Pasien Rawat Jalan\"\n  },\n  \"participant\": [\n    {\n      \"type\": [\n        {\n          \"coding\": [\n            {\n              \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ParticipationType\",\n              \"code\": \"ATND\",\n              \"display\": \"attender\"\n            }\n          ]\n        }\n      ],\n      \"individual\": {\n        \"reference\": \"Practitioner/{{practitioner_ihs}}\",\n        \"display\": \"dr. Dokter Pemeriksa\"\n      }\n    }\n  ],\n  \"period\": {\n    \"start\": \"2026-11-17T09:00:00+07:00\"\n  },\n  \"location\": [\n    {\n      \"location\": {\n        \"reference\": \"Location/{{location_id}}\",\n        \"display\": \"Poli Umum\"\n      }\n    }\n  ],\n  \"serviceProvider\": {\n    \"reference\": \"Organization/{{org_id}}\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/Encounter", "host": ["{{base_url}}"], "path": ["Encounter"] }
          }
        }
      ]
    },
    {
      "name": "3. Diperiksa Dokter (Pemeriksaan Medis)",
      "item": [
        {
          "name": "3.1 Update Encounter (Status: in-progress)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Encounter\",\n  \"id\": \"{{encounter_id}}\",\n  \"status\": \"in-progress\",\n  \"class\": {\n    \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n    \"code\": \"AMB\",\n    \"display\": \"ambulatory\"\n  },\n  \"subject\": {\n    \"reference\": \"Patient/{{patient_ihs}}\"\n  },\n  \"serviceProvider\": {\n    \"reference\": \"Organization/{{org_id}}\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/Encounter/{{encounter_id}}", "host": ["{{base_url}}"], "path": ["Encounter", "{{encounter_id}}"] }
          }
        },
        {
          "name": "3.2 Kirim Diagnosa ICD-10 (Condition)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Condition\",\n  \"clinicalStatus\": {\n    \"coding\": [{\n      \"system\": \"http://terminology.hl7.org/CodeSystem/condition-clinical\",\n      \"code\": \"active\",\n      \"display\": \"Active\"\n    }]\n  },\n  \"category\": [{\n    \"coding\": [{\n      \"system\": \"http://terminology.hl7.org/CodeSystem/condition-category\",\n      \"code\": \"encounter-diagnosis\",\n      \"display\": \"Encounter Diagnosis\"\n    }]\n  }],\n  \"code\": {\n    \"coding\": [{\n      \"system\": \"http://hl7.org/fhir/sid/icd-10\",\n      \"code\": \"J00\",\n      \"display\": \"Acute nasopharyngitis [common cold]\"\n    }]\n  },\n  \"subject\": { \"reference\": \"Patient/{{patient_ihs}}\" },\n  \"encounter\": { \"reference\": \"Encounter/{{encounter_id}}\" }\n}"
            },
            "url": { "raw": "{{base_url}}/Condition", "host": ["{{base_url}}"], "path": ["Condition"] }
          }
        },
        {
          "name": "3.3 Kirim Tanda Vital - Tekanan Darah (Observation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Observation\",\n  \"status\": \"final\",\n  \"category\": [{\n    \"coding\": [{\n      \"system\": \"http://terminology.hl7.org/CodeSystem/observation-category\",\n      \"code\": \"vital-signs\",\n      \"display\": \"Vital Signs\"\n    }]\n  }],\n  \"code\": {\n    \"coding\": [{\n      \"system\": \"http://loinc.org\",\n      \"code\": \"85354-9\",\n      \"display\": \"Blood pressure panel\"\n    }]\n  },\n  \"subject\": { \"reference\": \"Patient/{{patient_ihs}}\" },\n  \"encounter\": { \"reference\": \"Encounter/{{encounter_id}}\" },\n  \"component\": [\n    {\n      \"code\": {\n        \"coding\": [{\n          \"system\": \"http://loinc.org\",\n          \"code\": \"8480-6\",\n          \"display\": \"Systolic blood pressure\"\n        }]\n      },\n      \"valueQuantity\": { \"value\": 120, \"unit\": \"mm[Hg]\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mm[Hg]\" }\n    },\n    {\n      \"code\": {\n        \"coding\": [{\n          \"system\": \"http://loinc.org\",\n          \"code\": \"8462-4\",\n          \"display\": \"Diastolic blood pressure\"\n        }]\n      },\n      \"valueQuantity\": { \"value\": 80, \"unit\": \"mm[Hg]\", \"system\": \"http://unitsofmeasure.org\", \"code\": \"mm[Hg]\" }\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/Observation", "host": ["{{base_url}}"], "path": ["Observation"] }
          }
        },
        {
          "name": "3.4 Kirim E-Resep Obat (MedicationRequest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('medication_request_id', json.id);",
                  "    console.log('✅ MedicationRequest ID tersimpan:', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"MedicationRequest\",\n  \"status\": \"active\",\n  \"intent\": \"order\",\n  \"category\": [{\n    \"coding\": [{\n      \"system\": \"http://terminology.hl7.org/CodeSystem/medicationrequest-category\",\n      \"code\": \"outpatient\",\n      \"display\": \"Outpatient\"\n    }]\n  }],\n  \"medicationCodeableConcept\": {\n    \"coding\": [{\n      \"system\": \"http://sys-ids.kemkes.go.id/kfa\",\n      \"code\": \"93000123\",\n      \"display\": \"Paracetamol 500 mg Tablet\"\n    }]\n  },\n  \"subject\": { \"reference\": \"Patient/{{patient_ihs}}\" },\n  \"encounter\": { \"reference\": \"Encounter/{{encounter_id}}\" },\n  \"requester\": { \"reference\": \"Practitioner/{{practitioner_ihs}}\" },\n  \"dosageInstruction\": [{ \"text\": \"3 x 1 tablet sesudah makan\" }],\n  \"dispenseRequest\": { \"quantity\": { \"value\": 10, \"unit\": \"TAB\" } }\n}"
            },
            "url": { "raw": "{{base_url}}/MedicationRequest", "host": ["{{base_url}}"], "path": ["MedicationRequest"] }
          }
        }
      ]
    },
    {
      "name": "4. Farmasi & Selesai (MedicationDispense & Encounter Finished)",
      "item": [
        {
          "name": "4.1 Kirim Penyerahan Obat (MedicationDispense)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"MedicationDispense\",\n  \"status\": \"completed\",\n  \"medicationCodeableConcept\": {\n    \"coding\": [{\n      \"system\": \"http://sys-ids.kemkes.go.id/kfa\",\n      \"code\": \"93000123\",\n      \"display\": \"Paracetamol 500 mg Tablet\"\n    }]\n  },\n  \"subject\": { \"reference\": \"Patient/{{patient_ihs}}\" },\n  \"context\": { \"reference\": \"Encounter/{{encounter_id}}\" },\n  \"authorizingPrescription\": [{ \"reference\": \"MedicationRequest/{{medication_request_id}}\" }],\n  \"quantity\": { \"value\": 10, \"unit\": \"TAB\" },\n  \"whenHandedOver\": \"2026-11-17T10:00:00+07:00\"\n}"
            },
            "url": { "raw": "{{base_url}}/MedicationDispense", "host": ["{{base_url}}"], "path": ["MedicationDispense"] }
          }
        },
        {
          "name": "4.2 Update Encounter (Status: finished - Pasien Pulang)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resourceType\": \"Encounter\",\n  \"id\": \"{{encounter_id}}\",\n  \"status\": \"finished\",\n  \"class\": {\n    \"system\": \"http://terminology.hl7.org/CodeSystem/v3-ActCode\",\n    \"code\": \"AMB\",\n    \"display\": \"ambulatory\"\n  },\n  \"subject\": { \"reference\": \"Patient/{{patient_ihs}}\" },\n  \"serviceProvider\": { \"reference\": \"Organization/{{org_id}}\" },\n  \"period\": {\n    \"start\": \"2026-11-17T09:00:00+07:00\",\n    \"end\": \"2026-11-17T10:15:00+07:00\"\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/Encounter/{{encounter_id}}", "host": ["{{base_url}}"], "path": ["Encounter", "{{encounter_id}}"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "auth_url", "value": "https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1" },
    { "key": "base_url", "value": "https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1" },
    { "key": "org_id", "value": "18f72a06-417c-4467-b397-ba58a1dfff37" },
    { "key": "client_id", "value": "avgnGXlwnPrPcA9E52txEyAJNamooPDA5eSrHB7RPXBNtFCZ" },
    { "key": "client_secret", "value": "PBwaZf3vFMQDYj9yKYGiyXxKsWpSgMggwdsGHoBvmhYPERBPp1PJ51n9W717NWGU" },
    { "key": "access_token", "value": "" },
    { "key": "nik_pasien", "value": "1000000000000001" },
    { "key": "patient_ihs", "value": "P20395977056" },
    { "key": "practitioner_ihs", "value": "10001987654" },
    { "key": "location_id", "value": "b017aa54-f1df-4329-88bc-10f3994a2c3e" },
    { "key": "encounter_id", "value": "" },
    { "key": "medication_request_id", "value": "" }
  ]
}
